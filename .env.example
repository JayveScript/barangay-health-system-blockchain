# Database (use Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth — generate with: openssl rand -base64 32
JWT_SECRET="your-secret-here"

# Your Vercel URL — set in Vercel env vars after first deploy
# Repo: barangay-health-system-blockchain
NEXT_PUBLIC_APP_URL="https://barangay-health-system-blockchain.vercel.app"

# Optional: separate key for QR encryption (falls back to JWT_SECRET)
QR_ENCRYPTION_KEY=""

# Email (for OTP, password reset, registration)
EMAIL_USER=""
EMAIL_PASS=""

# SMS (optional)
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""

# ── Blockchain (private Ethereum via Hardhat) ─────────────────────────────────
# 1. cd blockchain && npm install
# 2. npm run node          (starts local chain on port 8545)
# 3. npm run deploy:local  (prints addresses — paste them below)

# Master on/off switch. Anchoring/audit is ON by default. Set to "false" to
# disable all on-chain writes/reads during heavy load testing (registrations,
# updates, and QR scans become instant, no transactions spent). Set back to
# "true" (or remove this line) before the demo to re-enable tamper-proofing.
# Changing this on Vercel requires a redeploy to take effect.
BLOCKCHAIN_ENABLED="true"

# Local development
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"

# Polygon Amoy (Alchemy)
BLOCKCHAIN_RPC_URL_AMOY=""

# Ethereum Sepolia (Infura) — recommended free option for Vercel/capstone
BLOCKCHAIN_RPC_URL_SEPOLIA=""

# Use one of the test accounts printed by `npm run node` (Hardhat Account #0)
BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Filled in after running deploy script
HEALTH_RECORD_REGISTRY_ADDRESS=""
AUDIT_LOG_ADDRESS=""

# Optional: salt for hashing IP addresses in audit logs
IP_HASH_SALT="change-me-to-a-random-string"
